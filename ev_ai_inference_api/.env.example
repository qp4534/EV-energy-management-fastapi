# Local Docker Compose defaults. Change the password outside local development.
POSTGRES_DB=ev_ai
POSTGRES_USER=ev_app
POSTGRES_PASSWORD=ev_app

# Container-network URLs used by the API, migration, and worker services.
DATABASE_URL=postgresql+asyncpg://ev_app:ev_app@postgres:5432/ev_ai
REDIS_URL=redis://redis:6379/0

MODEL_BUNDLE_DIR=/app/model_bundles/current_stage_v1/ev_battery_safety_inference_v1
SESSION_TTL_SECONDS=900
MAX_SESSIONS=1000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TWIN_INFRA_REQUIRED=true
TWIN_CONSUMER_GROUP=twin-persistence
TWIN_CONSUMER_NAME=worker-1
